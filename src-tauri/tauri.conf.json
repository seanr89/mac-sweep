{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mac Sweep",
  "version": "0.1.0",
  "identifier": "dev.macsweep.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mac Sweep",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
